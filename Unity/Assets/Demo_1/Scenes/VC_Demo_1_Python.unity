  m_Name: 
  m_EditorClassIdentifier: Pilar.Context::Pilar.Context.ContextNode
  _entries:
  - key: Function
    value: Seating sensor under the press. Detects that a part is present and correctly
      seated.
  - key: Signal
    value: Not a PLC symbol - its Link is disabled. It feeds PartPressDetector locally,
      which publishes the result to the PLC as B_NIO.
  - key: oc.plcPath
    value: MAIN.FG_04.Sensor
  - key: oc.deviceType
    value: SensorBinary
  - key: oc.simulationDevice
    value: true
  _topologySegment: 
