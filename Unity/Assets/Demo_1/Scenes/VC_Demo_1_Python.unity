  m_Script: {fileID: 11500000, guid: c5236d538fb060b48834286d70f34fa6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Pilar.Context::Pilar.Context.ContextNode
  _entries:
  - key: Function
    value: HORIZONTAL traverse for arm 1, despite the Y in the name. Min is home
      over slot 2, max is the transfer position. Arm 2 names its axes the opposite
      way round.
  - key: oc.plcPath
    value: MAIN.FG_03.Y_AxisY1
  - key: oc.deviceType
    value: Cylinder
  - key: Signal
    value: Double solenoid with both limits read. MAX is the transfer position, min
      is home over slot 2.
  _topologySegment: 
  _topologyParent: {fileID: 0}
