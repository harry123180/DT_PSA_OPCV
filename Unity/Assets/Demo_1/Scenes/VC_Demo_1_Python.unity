--- !u!114 &6992334927856846294
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3952784708755523571}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5236d538fb060b48834286d70f34fa6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Pilar.Context::Pilar.Context.ContextNode
  _entries:
  - key: oc.plcPath
    value: MAIN.FG_01.Y_LaserMark
  - key: oc.deviceType
    value: LinkByte
  - key: Twin
    value: LinkByte plus ActorStateColor for the beam visual. Its DataReader child
      is what actually writes the mark onto the payload.
  - key: Approximation
    value: The mark is one number written to a payload key, not geometry. Nothing
      is engraved and nothing can be inspected other than by reading that key back.
  - key: Signal
    value: One control bit out enables the laser module; held high for 1 s it applies
      the mark. NO status bits - the PLC gets no confirmation that it fired.
  _topologySegment: 
  _topologyParent: {fileID: 0}
