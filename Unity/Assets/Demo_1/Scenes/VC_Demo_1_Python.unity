--- !u!114 &2607148005758962434
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2925711752510060006}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5236d538fb060b48834286d70f34fa6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: PILAR.Context::PILAR.Context.ContextNode
  _entries:
  - key: Function
    value: Spawns the pallets that circulate through the machine.
  - key: Twin
    value: OC Source (a Detector) with Create() / Delete(), carrying _typeId and
      _uniqueId. The UniqueId it stamps is what FG_01's camera later reads back as
      the serial number.
  - key: Approximation
    value: Pallets appear from nothing on the source's own schedule. There is no
      upstream machine, no infeed sensor and nothing the PLC can command here.
  _topologySegment: 
  _topologyParent: {fileID: 0}
