  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5236d538fb060b48834286d70f34fa6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Pilar.Context::Pilar.Context.ContextNode
  _entries:
  - key: Function
    value: Not in order signal for the press. PartPressDetector raises it when the
      press cylinder has reached its bottom limit but the seating sensor sees no
      part - press completed with nothing correctly seated.
  - key: oc.plcPath
    value: MAIN.FG_04.B_NIO
  - key: oc.deviceType
    value: SignalBinary
  - key: Signal
    value: A VERDICT, not a sensor reading. Active means the press bottomed with
      nothing correctly seated. Only meaningful at the bottom limit with the hold
      expired.
  _topologySegment: 
  _topologyParent: {fileID: 0}
