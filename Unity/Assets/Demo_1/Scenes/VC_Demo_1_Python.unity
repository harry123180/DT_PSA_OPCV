  m_Name: 
  m_EditorClassIdentifier: Pilar.Context::Pilar.Context.ContextNode
  _entries:
  - key: Function
    value: Press cylinder. Strokes down to seat the part in its slot, holds 1 s,
      then retracts.
  - key: oc.plcPath
    value: MAIN.FG_04.Y_AxisZ
  - key: oc.deviceType
    value: Cylinder
  - key: Signal
    value: Double solenoid with both limits read. EXTENDED presses down onto the
      part; retracted is clear. A double solenoid so an abort leaves it where it
      is.
  _topologySegment: 
  _topologyParent: {fileID: 0}
